{
  "name": "omnirush2api",
  "version": "1.0.0",
  "description": "OAuth to OpenAI-compatible API router for Omnirush.ai models (Docker-ready, with upstream protocol fixes)",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "omnirush2api": "dist/cli.js"
  },
  "files": [
    "dist",
    "worker",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "build": "tsx scripts/build.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "tsx src/cli/index.ts start",
    "login": "tsx scripts/get-refresh-token.ts",
    "tokens": "tsx src/cli/index.ts tokens"
  },
  "keywords": [
    "omnirush",
    "openai",
    "oauth",
    "router",
    "proxy",
    "cloudflare-workers",
    "reverse-proxy",
    "gpt-6-astra",
    "gpt-6-sol"
  ],
  "author": "IMROVOID",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhu-alw/omnirush2api.git"
  },
  "bugs": {
    "url": "https://github.com/bhu-alw/omnirush2api/issues"
  },
  "homepage": "https://github.com/bhu-alw/omnirush2api#readme",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
