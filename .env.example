# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is git-ignored and never committed.
#
# On Blitz (or any Docker platform), set these as service variables instead
# of using this file.

# Bearer key that clients must send to the daemon.
# Leave empty to run without authentication (not recommended on a public URL).
API_KEY=sk-omnirush

# OAuth token pair from `node dist/cli.js login`.
# Format: <refresh_token>|<access_token>
# Multiple accounts: one pair per line (or comma-separated).
# THIS IS THE ONLY REQUIRED VARIABLE.
OMNIRUSH_REFRESH_TOKEN=

# Upstream gateway (the default is almost always what you want).
# OMNIRUSH_GATEWAY_URL=https://omnirush.ai/omnirush/v1

# Daemon listen address.
# HOST: use 0.0.0.0 inside a container so the port is reachable from outside.
# PORT: on a PaaS that assigns a port (Blitz etc.), LEAVE THIS EMPTY - it is injected.
# HOST=0.0.0.0
# PORT=20129
