# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is git-ignored and never committed.

# Bearer key that clients must send to the local daemon.
# Leave empty to run without authentication.
API_KEY=sk-omnirush

# OAuth token pair from `node dist/cli.js login`.
# Format: <refresh_token>|<access_token>
# Multiple accounts: one pair per line.
OMNIRUSH_REFRESH_TOKEN=

# Upstream gateway (the default is almost always what you want).
# OMNIRUSH_GATEWAY_URL=https://omnirush.ai/omnirush/v1

# Daemon listen address.
# PORT=20129
# HOST=0.0.0.0
